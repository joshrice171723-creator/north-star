# Dependencies
node_modules/

# Build output
dist/
release/
out/

# Local environment and secrets
.env
.env.*
!.env.example

# Electron / Vite caches
.vite/
.cache/

# Local app data and logs
*.log
logs/

# OS/editor files
.DS_Store
Thumbs.db
