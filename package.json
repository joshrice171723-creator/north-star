{
  "name": "claude-architect-study-coach-native",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --host 127.0.0.1 --strictPort --port 5174",
    "build": "vite build",
    "desktop": "concurrently -k -s first \"npm run start\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "desktop:prod": "npm run build && electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "playwright": "^1.62.1",
    "wait-on": "latest"
  }
}
